<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>StardewDS</RootNamespace>
    <AssemblyName>StardewDS</AssemblyName>
    <Version>1.0.0-alpha.2</Version>
    <EnableModDeploy>true</EnableModDeploy>
    <EnableModZip>true</EnableModZip>
  </PropertyGroup>

  <ItemGroup>
    <!-- ci-tools/ is a standalone tool (mod/ci-tools/refstrip) for regenerating
         the CI secrets in mod/README.md#ci-builds - not part of this mod, but
         nested under mod/ for organization. Exclude it from the default **/*.cs
         glob so its top-level-statement Program.cs doesn't get compiled into
         this class library alongside the mod's own code. -->
    <Compile Remove="ci-tools/**/*.cs" />
    <None Remove="ci-tools/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Pathoschild.Stardew.ModBuildConfig" Version="4.4.0" />
    <!-- Harmony patching, for suppressing the vanilla toolbar draw call (see HudPatches.cs). -->
    <PackageReference Include="Lib.Harmony" Version="2.3.3" />
  </ItemGroup>

</Project>
